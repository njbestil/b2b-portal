{
  "name": "@b2b-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=@b2b-portal/config --workspace=@b2b-portal/contracts && tsc",
    "typecheck": "npm run build --workspace=@b2b-portal/config --workspace=@b2b-portal/contracts && tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "prettier . --ignore-path ../../.prettierignore --check",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "npm run build && node --env-file-if-exists=../../.env dist/migrate.js",
    "demo": "npm run build && node --env-file-if-exists=../../.env dist/demo.js",
    "sync:catalog": "npm run build && node --env-file-if-exists=../../.env dist/sync-catalog.js",
    "test": "npm run build && npm run build --workspace=@b2b-portal/mock-erp && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@b2b-portal/config": "0.0.0",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@b2b-portal/contracts": "0.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
