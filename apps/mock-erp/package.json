{
  "name": "@b2b-portal/mock-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=@b2b-portal/config && tsc",
    "typecheck": "npm run build --workspace=@b2b-portal/config && tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --ignore-path ../../.prettierignore --write",
    "format:check": "prettier . --ignore-path ../../.prettierignore --check",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@b2b-portal/config": "0.0.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2"
  }
}
