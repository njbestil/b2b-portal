# Copy this file to .env at the repository root before starting the services.
# Values supplied by the shell or deployment environment take precedence.
NODE_ENV=development

# API listener
API_HOST=127.0.0.1
API_PORT=3000

# Optional PostgreSQL pool. Leave DATABASE_URL empty for database-free startup.
# Supply credentials through local/deployment secrets, never commit a real URL.
DATABASE_URL=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=1000
PG_IDLE_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=5000

# Mock ERP listener
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_PORT=3001

# Optional backend-only ERP gateway; leave empty to report unconfigured.
# Local Mock ERP example: http://127.0.0.1:3001/mock-erp/v1
ERP_BASE_URL=
ERP_TIMEOUT_MS=1000
